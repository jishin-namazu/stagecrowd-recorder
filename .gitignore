# Credentials and key material. These must never be committed — a token or a CDM
# in history stays there, and rewriting history does not un-publish it.
.env
.env.*
!.env.example
.stagecrowd
.stagecrowd.*
*.wvd
keys.txt
license.txt
pssh.txt

# Run output. The recorder writes artefacts and shards as siblings, both named
# after the run, so matching the run prefix catches the pair wherever the working
# directory happens to be.
archive/
run_*/
run_*.out/

# Media, in case a recording is moved out of archive/ by hand.
*.ts
*.m4s
*.mkv
*.mp4
*.m4a
*.aac

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
